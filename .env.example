# Optional — primary stack is the local learning bot (`npm start` / `npm run bot`).
# Only set these if you wire the dashboard to a real Supabase project.

# Supabase Project URL (must be a real https://xxxx.supabase.co URL)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Supabase Public Anonymous Key (safe for the browser)
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"
